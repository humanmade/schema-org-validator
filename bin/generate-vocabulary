#!/usr/bin/env php
<?php

declare(strict_types=1);

use HumanMade\SchemaOrgValidator\Generator\Cli;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

exit((new Cli())->run(array_slice($_SERVER['argv'], 1)));
