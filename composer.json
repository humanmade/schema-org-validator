{
	"name": "humanmade/schema-org-validator",
	"description": "Validate schema.org JSON-LD graphs against the full vocabulary and optional rule profiles such as Google rich results.",
	"type": "library",
	"license": "GPL-2.0-or-later",
	"keywords": ["schema.org", "json-ld", "structured data", "validation", "rich results"],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"phpstan/phpstan": "^1.12",
		"squizlabs/php_codesniffer": "^3.13"
	},
	"autoload": {
		"psr-4": {
			"HumanMade\\SchemaOrgValidator\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"HumanMade\\SchemaOrgValidator\\Tests\\": "tests/"
		}
	},
	"bin": ["bin/generate-vocabulary"],
	"config": {
		"sort-packages": true,
		"platform": {
			"php": "8.0.30"
		}
	},
	"scripts": {
		"test": "phpunit",
		"analyse": "phpstan analyse --memory-limit=1G",
		"lint": "phpcs",
		"generate": "@php bin/generate-vocabulary"
	}
}
